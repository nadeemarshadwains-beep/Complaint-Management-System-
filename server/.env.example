# Example environment variables for SMS proxy
PORT=3000
PROXY_SECRET=change_this_for_prod_or_leave_empty_for_local_dev

# Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Vonage / Nexmo (optional)
VONAGE_API_KEY=
VONAGE_API_SECRET=
VONAGE_FROM=

# Custom gateway (optional)
CUSTOM_GATEWAY_URL=
CUSTOM_GATEWAY_KEY=
